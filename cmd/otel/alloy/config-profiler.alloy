// profile 采集：定时拉取两个服务的 /debug/pprof，写入 Pyroscope。
// 必须单实例——多个实例同时抓同一个进程会触发
// "Could not enable CPU profiling: cpu profiling already in use"。

pyroscope.scrape "services" {
	targets = [
		{"__address__" = "order-service:6060", "service_name" = "order-service"},
		{"__address__" = "inventory-service:6060", "service_name" = "inventory-service"},
	]

	forward_to = [pyroscope.write.default.receiver]
}

pyroscope.write "default" {
	endpoint {
		url = "http://lgtm:4040"
	}
}
